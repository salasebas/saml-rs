{
  "framework": null,
  "installCommand": "npx --yes pnpm@11.6.0 --dir site install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@11.6.0 --dir site build",
  "outputDirectory": "site/dist",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- site docs/conformance vercel.json || exit 1",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
