{
  "realm": "saml-rs",
  "enabled": true,
  "sslRequired": "none",
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "saml-rs-test-rsa",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": [
            "200"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "RS256"
          ],
          "keyUse": [
            "SIG"
          ],
          "privateKey": [
            ""
          ],
          "certificate": [
            ""
          ]
        }
      }
    ]
  },
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice-password",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "http://localhost:3000/saml/metadata",
      "name": "saml-rs axum-sp",
      "protocol": "saml",
      "enabled": true,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "attributes": {
        "saml_name_id_format": "email",
        "saml_force_name_id_format": "false",
        "saml.authnstatement": "true",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#",
        "saml.client.signature": "true",
        "saml.signing.certificate": "",
        "saml.encrypt": "false",
        "saml.force.post.binding": "false",
        "saml_assertion_consumer_url_post": "http://localhost:3000/saml/acs",
        "saml_single_logout_service_url_redirect": "http://localhost:3000/saml/slo"
      }
    }
  ]
}
