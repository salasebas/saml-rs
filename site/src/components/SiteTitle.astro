---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import DocsVersion from './DocsVersion.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

{hasSidebar ? <SiteTitle /> : (
	<div class="title-with-version">
		<SiteTitle />
		<DocsVersion />
	</div>
)}

<style>
	.title-with-version {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.title-with-version :global(.site-title) {
		flex: none;
	}
</style>
